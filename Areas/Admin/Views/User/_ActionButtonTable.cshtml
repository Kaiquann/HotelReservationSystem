@model User

@if (Model.IsDeleted == 0)
{
    @if (!Model.IsBlocked)
    {
        <form data-ajax="true"
              data-ajax-update="#table-ajax"
              action="/Admin/User/Block?ids=@Model.Id"
              method="post">
            <button data-confirm="Are you sure to block this user?"
                    class="btn btn-warning btn-sm">
                <i class="fas fa-ban me-2" aria-hidden="true"></i> Block
            </button>
        </form>
    }
    else
    {
        <form data-ajax="true"
              data-ajax-update="#table-ajax"
              action="/Admin/User/Unblock?ids=@Model.Id"
              method="post">
            <button data-confirm="Are you sure to unblock this user?"
                    class="btn btn-warning btn-sm">
                <i class="fas fa-unlock me-2" aria-hidden="true"></i> Unblock
            </button>
        </form>
    }

    <form data-ajax="true"
          data-ajax-update="#table-ajax"
          action="/Admin/User/Delete?ids=@Model.Id"
          method="post">
        <button data-confirm="Are you sure to delete this user?"
                class="btn btn-danger btn-sm">
            <i class="fas fa-trash me-2" aria-hidden="true"></i> Delete
        </button>
    </form>
}
else if (Model.IsDeleted == 1)
{
    <form data-ajax="true"
          data-ajax-update="#table-ajax"
          action="/Admin/User/Recover?ids=@Model.Id"
          method="post">
        <button data-confirm="Are you sure to recover this user?"
                class="btn btn-warning btn-sm">
            <i class="fas fa-undo me-2" aria-hidden="true"></i> Recover
        </button>
    </form>
    <form data-ajax="true"
          data-ajax-update="#table-ajax"
          action="/Admin/User/PermanentDelete?ids=@Model.Id"
          method="post">
        <button data-confirm="Are you sure to permanently delete this user?"
                class="btn btn-danger btn-sm">
            <i class="fas fa-times me-2" aria-hidden="true"></i> Permanent Delete
        </button>
    </form>
}
@model IPagedList<User>
@{
    string[] fields =
    [
        "", "Id", "FirstName", "LastName",
        "Email", "PhoneNumber", "Role",
        "Actions"
    ];
}

<partial name="_SweetAlert"/>

<partial name="Table/_FilterFormPartial"/>
<partial name="Table/_SearchBarPartial"/>
<partial name="Table/_CountRecordPartial" model="@Model"/>
<table class="table table-bordered table-sm">
    <partial name="Table/_HeaderPartial" model="@fields"/>
    <tbody>
    @foreach (var user in Model)
    {
        <tr data-checkable>
            <td>
                <input type="checkbox" name="ids" value="@user.Id" form="select-form" class="select-box"/>
            </td>
            <td>@user.Id</td>
            <td>@user.FirstName</td>
            <td>@user.LastName</td>
            <td>@user.Email</td>
            <td>@user.PhoneNumber</td>
            <td>@user.Role</td>
            <td class="d-flex justify-content-center align-items-center gap-1">
                <a asp-area="Admin" asp-controller="User" asp-action="Show" asp-route-id="@user.Id" class="btn btn-secondary btn-sm">
                    <i class="fas fa-eye me-2" aria-hidden="true"></i> View
                </a>
                <a asp-area="Admin" asp-controller="User" asp-action="Edit" asp-route-id="@user.Id" class="btn btn-primary btn-sm">
                    <i class="fas fa-edit me-2" aria-hidden="true"></i> Edit
                </a>
                <partial name="_ActionButtonTable" model="@user"/>
                <div class="popup">
                    <partial name="User/_ProfileImagePartial" model="user.ProfileImageUrl"/>
                </div>
            </td>
        </tr>
    }
    </tbody>
</table>
<partial name="Table/_FooterPartial" model="@Model"/>
@model IPagedList<Transaction>
@{
    string[] fields =
    [
        "", "Transaction Number", "Payment Method",
        "Service Charge", "Total Amount", "Status",
        "Created At", "Updated At", "Actions"
    ];
}

<partial name="Table/_FilterFormPartial"/>
<partial name="Table/_SearchBarPartial"/>
<partial name="Table/_CountRecordPartial" model="@Model"/>
<table class="table table-bordered table-sm">
    <partial name="Table/_HeaderPartial" model="@fields"/>
    <tbody>
    @foreach (var transaction in Model)
    {
        <tr data-checkable>
            <td>
                <input type="checkbox" name="ids" value="@transaction.Id" form="select-form" class="select-box"/>
            </td>
            <td>@transaction.TransactionNumber</td>
            <td>@transaction.PaymentMethod</td>
            <td>RM @transaction.ServiceCharge</td>
            <td>RM @transaction.TotalAmount</td>
            <td>@EnumHelper.GetDisplayName(transaction.Status)</td>
            <td>@transaction.CreatedAt</td>
            <td>@transaction.UpdatedAt</td>
            <td>
                <a href="/Admin/Transaction/Receipt/@transaction.TransactionNumber" class="btn btn-secondary btn-sm">
                    <i class="fas fa-eye me-2" aria-hidden="true"></i> View
                </a>
            </td>
        </tr>
    }
    </tbody>
</table>
<partial name="Table/_FooterPartial" model="@Model"/>
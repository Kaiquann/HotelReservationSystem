@model ShowOrderVm

<div class="card-body" data-printable-id="@Model.Order.OrderNumber">
    <partial name="Order/_OrderBodyDetailsPartial" model="@Model.Order"/>
    <partial name="Transaction/_BookingsPartial" model="@Model.Bookings"/>
</div>

<div class="card-footer">
    <div class="d-flex justify-content-between align-items-center">
        <!-- Left-aligned button -->
        <div>
            <a asp-area="Admin" asp-controller="Order" asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2" aria-hidden="true"></i> Go Back
            </a>
        </div>

        <!-- Center-aligned buttons -->
        <div class="d-flex justify-content-center align-items-center text-center gap-1">
            <a asp-area="Admin" asp-controller="Transaction" asp-action="Receipt" asp-route-id="@Model.Order.TransactionNumber" class="btn btn-primary">
                <i class="fas fa-receipt me-2" aria-hidden="true"></i> View Receipt
            </a>

            <button class="btn btn-primary print_btn" data-print-id="@Model.Order.OrderNumber">
                <i class="fas fa-print me-2" aria-hidden="true"></i> Print Order
            </button>

            @if (Model.Order.Status == OrderStatus.PendingRefund)
            {
                <form data-ajax="true"
                      data-ajax-update="#ajax-update-content"
                      asp-area="Admin"
                      asp-controller="Order"
                      asp-action="Refund"
                      asp-route-id="@Model.Order.OrderNumber"
                      method="post"
                      id="Refund_@Model.Order.OrderNumber">
                </form>
                <button data-confirm="Are you sure to refund this order?"
                        class="btn btn-warning"
                        form="Refund_@Model.Order.OrderNumber">
                    <i class="fas fa-dollar me-2" aria-hidden="true"></i> Refund
                </button>
            }
        </div>

        <!-- Right-aligned button -->
        <div>
            @if (Model.Order.IsOrderAllowToEdit())
            {
                <a asp-area="Admin" asp-controller="Order" asp-action="Edit" asp-route-id="@Model.Order.OrderNumber" class="btn btn-primary">
                    <i class="fas fa-edit me-2" aria-hidden="true"></i> Edit
                </a>
            }
        </div>
    </div>
</div>
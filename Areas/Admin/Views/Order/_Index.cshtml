@model IPagedList<Order>
@{
    Layout = "";
    string[] fields =
    [
        "", "Order Number", "Transaction Number", "Status",
        "Service Charge", "SubTotal", "Total Amount",
        "Created At", "Actions"
    ];
}

<partial name="_SweetAlert"/>

<partial name="Table/_FilterFormPartial"/>
<partial name="Table/_SearchBarPartial"/>
<partial name="Table/_CountRecordPartial" model="@Model"/>
<table class="table table-bordered table-sm">
    <partial name="Table/_HeaderPartial" model="@fields"/>
    <tbody>
    @foreach (var order in Model)
    {
        <tr data-checkable>
            <td>
                <input type="checkbox" name="ids" value="@order.Id" form="select-form" class="select-box"/>
            </td>
            <td>@order.OrderNumber</td>
            <td>@order.TransactionNumber</td>
            <td>@EnumHelper.GetDisplayName(order.Status)</td>
            <td>RM @order.ServiceCharge</td>
            <td>RM @order.SubTotalAmount</td>
            <td>RM @order.TotalAmount</td>
            <td>@order.CreatedAt</td>
            <td>
                <div class="d-flex justify-content-center align-items-center gap-1">
                    <a asp-area="Admin" asp-controller="Order" asp-action="Show" asp-route-id="@order.OrderNumber" class="btn btn-secondary btn-sm">
                        <i class="fas fa-eye me-2" aria-hidden="true"></i> View
                    </a>
                    <partial name="_ActionButtonTable" model="@order"/>
                </div>
            </td>
        </tr>
    }
    </tbody>
</table>
<partial name="Table/_FooterPartial" model="@Model"/>
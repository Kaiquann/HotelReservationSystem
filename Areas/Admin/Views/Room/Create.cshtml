@model CreateRoomVm
@{
    ViewBag.Title = "Add Rooms";
}

<section>
    <div class="container my-5">
        <h2 class="text-center mb-4 text-primary">@ViewBag.Title</h2>

        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-area="Admin" asp-controller="Room" asp-action="Store">
                    <div class="mb-4">
                        <h5 class="fw-bold">Room Category</h5>
                        <div class="border p-3 rounded bg-light">
                            @foreach (var roomCategory in Model.RoomCategoryList)
                            {
                                <div class="form-check mb-2">
                                    <input type="radio" class="form-check-input"
                                           asp-for="RoomCategory" value="@roomCategory.Id" id="@roomCategory.Id"/>
                                    <label class="form-check-label" for="@roomCategory.Id">
                                        @roomCategory.Type
                                    </label>
                                </div>
                            }
                            <span asp-validation-for="RoomCategory" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h5 class="fw-bold">Room Setting</h5>
                        <div class="border p-3 rounded bg-light">
                            @foreach (var roomSetting in Model.RoomSettingList)
                            {
                                <div class="form-check mb-2 d-flex align-items-center">
                                    <input type="radio" class="form-check-input"
                                           asp-for="RoomSetting"
                                           value="@roomSetting.Id"
                                           id="@roomSetting.Id"/>
                                    <label class="form-check-label ms-2" for="@roomSetting.Id">
                                        @if (roomSetting.IsSmokingArea)
                                        {
                                            <i class="fa fa-smoking text-danger me-2"></i>
                                            <span>Smoking Area</span>
                                        }
                                        @if (roomSetting.IsLandscapeArea)
                                        {
                                            <i class="fa fa-tree text-success me-2"></i>
                                            <span>Landscape View</span>
                                        }
                                        @if (roomSetting.IsCornerRoom)
                                        {
                                            <i class="fa fa-building text-secondary ms-4 me-2"></i>
                                            <span class="ms-2">Corner Room</span>
                                        }
                                    </label>
                                </div>
                            }

                            <span asp-validation-for="RoomSetting" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="text-end">
                        <a asp-area="Admin" asp-controller="Room" asp-action="Index" class="btn btn-outline-secondary me-2">
                            <i class="fa fa-arrow-left"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-success">
                            <i class="fa fa-plus"></i> Add
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
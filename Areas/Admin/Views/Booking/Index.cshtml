@model IPagedList<Booking>
@{
    ViewBag.Title = "Manage Bookings";
}

<section>
    <div class="container my-5">
        <h2 class="text-center mb-4">@ViewBag.Title</h2>

        <div class="d-flex justify-content-start align-items-center mb-3 gap-1">
            <a asp-area="Admin"
               asp-controller="Booking"
               asp-action="ScanQr"
               class="btn btn-success">
                <i class="fas fa-qrcode me-2" aria-hidden="true"></i> Scan QR
            </a>
        </div>

        <div class="d-flex justify-content-start align-items-center mb-3 gap-1">
            <i class="fas fa-tasks me-2" aria-hidden="true"></i> <b>Bulk Actions</b>
            <button type="button"
                    data-ajax="true"
                    data-ajax-update="#table-ajax"
                    data-message="Are you sure to apply the role to all the selected bookings?"
                    data-action="/Admin/Booking/CheckIn"
                    class="select-submit-btn btn btn-success"
                    form="select-form">
                <i class="fas fa-check me-2" aria-hidden="true"></i> Check In
            </button>
            <button type="button"
                    data-ajax="true"
                    data-ajax-update="#table-ajax"
                    data-message="Are you sure to apply the role to all the selected bookings?"
                    data-action="/Admin/Booking/CheckOut"
                    class="select-submit-btn btn btn-success"
                    form="select-form">
                <i class="fas fa-check me-2" aria-hidden="true"></i> Check Out
            </button>
        </div>

        <partial name="_FilterBar"/>

        <div id="table-ajax">
            <partial name="_Index"/>
        </div>
    </div>
</section>
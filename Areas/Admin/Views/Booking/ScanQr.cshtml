@{
    ViewBag.Title = "Scan Booking QR";
}

<section>
    <div class="container my-5">
        <h2 class="text-center mb-4">@ViewBag.Title</h2>

        <div class="d-flex justify-content-start align-items-center mb-3 gap-1">
            <a asp-area="Admin" asp-controller="Booking" asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2" aria-hidden="true"></i> Go Back
            </a>
        </div>

        <div class="card">
            <div class="card-body">
                <div id="reader"></div>
                <div id="scan-result"></div>
                <button data-qrcode>Start QR Scanner</button>
            </div>
        </div>
    </div>
</section>
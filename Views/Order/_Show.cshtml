@model ShowOrderVm

<partial name="_SweetAlert"/>

<div class="card-body" data-printable-id="@Model.Order.OrderNumber">
    <partial name="Order/_OrderBodyDetailsPartial" model="@Model.Order"/>
    <partial name="Transaction/_BookingsPartial" model="@Model.Bookings"/>
</div>

<div class="card-footer">
    <div class="d-flex justify-content-between align-items-center">
        <!-- Left-aligned button -->
        <div>
            <a asp-area="" asp-controller="Order" asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left" aria-hidden="true"></i> Go Back
            </a>
        </div>

        <!-- Center-aligned buttons -->
        <div class="text-center">
            <a asp-area="" asp-controller="Transaction" asp-action="Receipt" asp-route-id="@Model.Order.TransactionNumber" class="btn btn-primary">
                <i class="fas fa-receipt" aria-hidden="true"></i> View Receipt
            </a>

            <button class="btn btn-primary print_btn" data-print-id="@Model.Order.OrderNumber">
                <i class="fas fa-print me-2" aria-hidden="true"></i> Print Order
            </button>
        </div>

        <!-- Right-aligned button -->
        <div>
            @if (Model.Order.IsOrderAllowToCancel())
            {
                <form data-ajax="true"
                      data-ajax-update="#ajax-update-content"
                      action="/Order/Cancel/@Model.Order.OrderNumber"
                      method="post"
                      id="@Model.Order.OrderNumber">
                </form>
                <button class="btn btn-danger"
                        data-confirm="Are you sure you want to cancel this order and process a refund?"
                        form="@Model.Order.OrderNumber">
                    <i class="fas fa-times-circle" aria-hidden="true"></i> Cancel Order
                </button>
            }
        </div>
    </div>
</div>
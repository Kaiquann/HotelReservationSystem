@model IPagedList<Order>
@{
    string[] fields =
    [
        "Order Number", "Transaction Number", "Status",
        "Service Charge", "SubTotal", "Total Amount",
        "Created At", "Actions"
    ];
}

<partial name="_SweetAlert"/>

<partial name="Table/_FilterFormPartial"/>
<partial name="Table/_SearchBarPartial"/>
<partial name="Table/_CountRecordPartial" model="@Model"/>
<table class="table table-bordered table-sm">
    <partial name="Table/_HeaderPartial" model="@fields"/>
    <tbody>
    @foreach (var order in Model)
    {
        <tr>
            <td>@order.OrderNumber</td>
            <td>@order.TransactionNumber</td>
            <td>@EnumHelper.GetDisplayName(order.Status)</td>
            <td>RM @order.ServiceCharge</td>
            <td>RM @order.SubTotalAmount</td>
            <td>RM @order.TotalAmount</td>
            <td>@order.CreatedAt</td>
            <td>
                <div class="d-flex justify-content-center align-items-center gap-1">
                    <a asp-area="" asp-controller="Order" asp-action="Show" asp-route-id="@order.OrderNumber" class="btn btn-secondary btn-sm">
                        <i class="fas fa-eye" aria-hidden="true"></i> View
                    </a>
                    @if (order.IsOrderAllowToCancel())
                    {
                        <form data-ajax="true"
                              data-ajax-update="#table-ajax"
                              action="/Order/Cancel/@order.OrderNumber"
                              method="post"
                              id="Cancel_@order.OrderNumber">
                        </form>
                        <button class="btn btn-danger btn-sm"
                                data-confirm="Are you sure you want to cancel this order and process a refund?"
                                form="Cancel_@order.OrderNumber">
                            <i class="fas fa-times-circle" aria-hidden="true"></i> Cancel Order
                        </button>
                    }
                </div>
            </td>
        </tr>
    }
    </tbody>
</table>
<partial name="Table/_FooterPartial" model="@Model"/>
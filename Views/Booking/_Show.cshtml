@model Booking

<div class="card-body">
    <table class="table table-bordered">
        @*
        <thead>
        <tr>
            <td colspan="3">
                <partial name="User/_ProfileImagePartial" model="@Model.Room.RoomCategory.RoomImages"/>
            </td>
        </tr>
        </thead>
*@
        <tbody>
        <tr>
            <th>Id</th>
            <td>:</td>
            <td>@Model.Id</td>
        </tr>
        <tr>
            <th>Order Number</th>
            <td>:</td>
            <td>@Model.Order.OrderNumber</td>
        </tr>
        <tr>
            <th>Room Number</th>
            <td>:</td>
            <td>@Model.RoomNumber</td>
        </tr>
        <tr>
            <th>Room Type</th>
            <td>:</td>
            <td>@Model.Room.RoomCategory.Type</td>
        </tr>
        <tr>
            <th>Status</th>
            <td>:</td>
            <td>@EnumHelper.GetDisplayName(Model.Status)</td>
        </tr>
        <tr>
            <th>Is Add Bed?</th>
            <td>:</td>
            <td>@(Model.IsAddBed ? "Yes" : "No")</td>
        </tr>
        <tr>
            <th>Preference</th>
            <td>:</td>
            <td>@(Model.Room.RoomSetting.GetRoomPreference())</td>
        </tr>
        <tr>
            <th>Is Corner Room?</th>
            <td>:</td>
            <td>@(Model.Room.RoomSetting.IsCornerRoom ? "Yes" : "No")</td>
        </tr>
        <tr>
            <th>Check In Date</th>
            <td>:</td>
            <td>@Model.CheckInDate</td>
        </tr>
        <tr>
            <th>Check Out Date</th>
            <td>:</td>
            <td>@Model.CheckOutDate</td>
        </tr>
        <tr>
            <th>When Check In</th>
            <td>:</td>
            <td>@(Model.WhenCheckInDateTime == null ? "N/A" : Model.WhenCheckInDateTime)</td>
        </tr>
        <tr>
            <th>When Check Out</th>
            <td>:</td>
            <td>@(Model.WhenCheckOutDateTime == null ? "N/A" : Model.WhenCheckOutDateTime)</td>
        </tr>
        </tbody>
    </table>

    @if ((Model.Status == BookingStatus.Confirmed && DateTime.Today.Date >= Model.CheckInDate.Date) ||
         Model.Status == BookingStatus.CheckedIn)
    {
        <!-- Qr Code -->
        <div class="text-center">
            <img src="data:image/png;base64,@ViewBag.QrCode" alt="Image" class="img-thumbnail" loading="lazy" style="max-height: 200px; max-width: 200px;"/>
        </div>
    }
</div>

<div class="card-footer">
    <div class="d-flex justify-content-between align-items-center">
        <!-- Left-aligned button -->
        <div>
            <a asp-area="" asp-controller="Booking" asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2" aria-hidden="true"></i> Go Back
            </a>
        </div>

        <!-- Center-aligned buttons -->
        <div class="d-flex justify-content-center align-items-center gap-1 text-center">
        </div>

        <!-- Right-aligned button -->
        <div>
        </div>
    </div>
</div>
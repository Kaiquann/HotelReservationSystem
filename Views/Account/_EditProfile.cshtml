@model ProfileVm

<partial name="_SweetAlert"/>

<form data-ajax="true"
      data-ajax-update="#ajax-update-content"
      asp-area=""
      asp-controller="Account"
      asp-action="RemoveProfileImage"
      method="post"
      id="removeProfileImageForm">
</form>

<form data-ajax="true"
      data-ajax-update="#ajax-update-content"
      asp-area=""
      asp-controller="Account"
      asp-action="EditProfile"
      method-="post"
      enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <table class="table table-bordered">
        <thead>
        <tr>
            <th>Profile Image</th>
            <td>:</td>
            <td>
                <label class="upload">
                    <input asp-for="ProfileImage" accept="image/jpeg,image/png" hidden>
                    <partial name="User/_ProfileImagePartial" model="@Model.ProfileImageUrl"/>
                    <span></span>
                </label>
                <span asp-validation-for="ProfileImage" class="text-danger"></span>
            </td>
        </tr>
        </thead>
        <tbody>
        <tr>
            <th>First name</th>
            <td>:</td>
            <td>
                <input asp-for="FirstName" class="form-control"/>
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </td>
        </tr>
        <tr>
            <th>Last name</th>
            <td>:</td>
            <td>
                <input asp-for="LastName" class="form-control"/>
                <span asp-validation-for="LastName" class="text-danger"></span>
            </td>
        </tr>
        <tr>
            <th>Username</th>
            <td>:</td>
            <td>
                <input asp-for="UserName" class="form-control"/>
                <span asp-validation-for="UserName" class="text-danger"></span>
            </td>
        </tr>
        <tr>
            <th>Phone number</th>
            <td>:</td>
            <td>
                <input asp-for="PhoneNumber" class="form-control"/>
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </td>
        </tr>
        </tbody>
        <tfoot>
        <tr>
            <td colspan="3">
                <div class="d-flex justify-content-between align-items-center">
                    <!-- Left-aligned button -->
                    <div>
                        <a asp-area="" asp-controller="Account" asp-action="Profile" class="btn btn-secondary">
                            <i class="fas fa-times me-2" aria-hidden="true"></i> Cancel
                        </a>
                    </div>

                    <!-- Center-aligned buttons -->
                    <div class="text-center">
                        <button class="btn btn-danger"
                                data-confirm="Are you sure to remove profile image?"
                                form="removeProfileImageForm">
                            <i class="fas fa-save me-2" aria-hidden="true"></i> Remove Profile Image
                        </button>
                    </div>

                    <!-- Right-aligned button -->
                    <div>
                        <button class="btn btn-success" data-confirm>
                            <i class="fas fa-save me-2" aria-hidden="true"></i> Save Changes
                        </button>
                    </div>
                </div>
            </td>
        </tr>
        </tfoot>
    </table>
</form>
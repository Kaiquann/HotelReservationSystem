@model SimpleTitleMessageVm

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>@Model.Title</title>
    <style>
        body { font-family: Arial, sans-serif }

        .container {
            margin: 0 auto;
            max-width: 600px;
            width: 100%;
        }

        .card {
            border: 1px solid #ddd;
            border-radius: 5px;
            margin-top: 50px;
            padding: 20px;
            text-align: center
        }

        .card-title {
            font-size: 24px;
            margin-bottom: 20px
        }

        .card-text {
            font-size: 18px;
            margin-bottom: 20px
        }

        .btn {
            background-color: #0d6efd;
            border-color: #0d6efd;
            border-radius: .25rem;
            color: #fff;
            display: inline-block;
            font-size: 1rem;
            line-height: 1.5;
            padding: .375rem .75rem;
            text-decoration: none
        }

        .btn:hover {
            background-color: #0b5ed7;
            border-color: #0a58ca;
            color: #fff;
        }
    </style>
</head>
<body>
<div class="container">
    <div class="card">
        <h5 class="card-title">@Model.Title</h5>
        <p class="card-text">@Model.Message</p>
    </div>
</div>
</body>
</html>
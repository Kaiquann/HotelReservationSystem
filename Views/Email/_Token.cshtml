@model TokenVm

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Token Verification</title>
    <style>
        body { font-family: Arial, sans-serif }

        .container {
            margin: 0 auto;
            max-width: 600px;
            width: 100%;
        }

        .card {
            border: 1px solid #ddd;
            border-radius: 5px;
            margin-top: 50px;
            padding: 20px;
            text-align: center
        }

        .card-title {
            font-size: 24px;
            margin-bottom: 20px
        }

        .card-text {
            font-size: 18px;
            margin-bottom: 20px
        }

        .token {
            font-size: 24px;
            font-weight: 700
        }
    </style>
</head>
<body>
<div class="container">
    <div class="card">
        <h5 class="card-title">Token Verification</h5>
        <p class="card-text">
            Your Token is:
            <br>
            <span class="token">
                @Model.Token
            </span>
        </p>
    </div>
</div>
</body>
</html>
@model ReceiptVm
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width,initial-scale=1"/>
    <title>Order Cancel Request</title>
    <style>
        body { font-family: Arial, sans-serif; }

        .container {
            margin: 0 auto;
            max-width: 600px;
            width: 100%;
        }

        .card {
            border: 1px solid #ddd;
            border-radius: 5px;
            margin-top: 50px;
            padding: 20px;
            text-align: center;
        }

        .card-title {
            font-size: 24px;
            margin-bottom: 20px;
        }

        .card-text {
            font-size: 18px;
            margin-bottom: 20px;
        }

        .btn {
            background-color: #0d6efd;
            border-color: #0d6efd;
            border-radius: 0.25rem;
            color: #fff;
            display: inline-block;
            font-size: 1rem;
            line-height: 1.5;
            padding: 0.375rem 0.75rem;
            text-decoration: none;
        }

        .btn:hover {
            background-color: #0b5ed7;
            border-color: #0a58ca;
            color: #fff;
        }

        .table {
            border-collapse: collapse;
            margin-bottom: 20px;
            width: 100%;
        }

        .table td {
            border: 1px solid #ddd;
            padding: 10px;
        }

        .table th {
            border: 1px solid #ddd;
            padding: 10px;
        }

        .table tr:nth-child(even) { background-color: #f2f2f2; }

        .table tr:hover { background-color: #ddd; }

        .table tr td:first-child { text-align: left; }

        .table tr td:last-child { text-align: left; }
    </style>
</head>
<body>
<div class="container">
    <div class="card">
        <div class="card-header">
            <div class="card-title">
                Order Cancel Request : @Model.Order.OrderNumber
            </div>
            <div class="card-text">
                We have received your request to cancel the order. Your order will be cancelled and refunded to your account within 7-14 business days. If you have any questions, please contact our support team.
            </div>
        </div>
        <div class="card-body">
            <partial name="Order/_OrderBodyDetailsPartial" model="@Model.Order"/>
            <partial name="Transaction/_BookingsPartial" model="@Model.Bookings"/>
        </div>
    </div>
</div>
</body>
</html>
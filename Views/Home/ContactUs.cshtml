@model SendContactUsVm
@{
    ViewBag.Title = "Contact Us";
}

<div class="contact-page">
<section class="bg-dark text-white py-4">
    <div class="container text-center">
        <p class="lead">Learn more about where we are and contact us</p>
    </div>
</section>
<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <div class="mb-4">
                    <h4 class="text-decoration-underline">Contact Details</h4>
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <h5 class="">Phone :</h5>
                            <p class="text-dark font-weight-bold">016-2342224</p>
                        </div>
                        <div class="col-md-12 text-left">
                            <h5 class="">Email :</h5>
                            <p class="text-dark font-weight-bold">contact@jxkq.com</p>
                        </div>
                        <div class="col-md-12 text-left">
                            <h5 class="">Address :</h5>
                            <p class="text-dark font-weight-bold">Genting SkyWorlds , Resorts World, 69000 Genting Highlands, Pahang</p>
                        </div>
                    </div>
                </div>

                <div>
                    <h4 class="text-decoration-underline mb-4">Send Us a Message</h4>
                    <form method="post" asp-action="SubmitContactUs" asp-controller="Home">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Name" class="form-label text-primary"></label>
                                <input asp-for="Name" class="form-control shadow-sm" id="name" required/>
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label text-primary"></label>
                                <input asp-for="Email" class="form-control shadow-sm" id="email" required/>
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Message" class="form-label text-primary"></label>
                            <textarea asp-for="Message" class="form-control shadow-sm" id="message" rows="4" required></textarea>
                            <span asp-validation-for="Message" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-danger">Send Message</button>
                    </form>

                </div>
            </div>

            <div class="col-md-6">
                <h4 class="text-decoration-underline mb-4">Find Us</h4>
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d60571.80065680311!2d101.74201303492465!3d3.3981162735304866!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31cc14067e9a39c3%3A0x1b8edcdc4d5bf56!2sGenting%20Highlands%2C%20Pahang!5e1!3m2!1sen!2smy!4v1735117046738!5m2!1sen!2smy"
                        width="100%" height="500" style="border: 0;" allowfullscreen="" loading="lazy">
                </iframe>
            </div>
        </div>
    </div>
</section>
</div>

@{
    ViewBag.Title = "About Us";
}

<style>
    .about-hero { position: relative; min-height: 500px; display: flex; align-items: center; overflow: hidden; color: #fff; background: #212529 url('/images/AboutUs.jpg') center 42% / cover no-repeat; }
    .about-hero::before { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg,rgba(20,20,20,.88),rgba(20,20,20,.56),rgba(20,20,20,.2)); }
    .about-hero-content { position: relative; z-index: 1; max-width: 680px; padding: 6rem 0; }
    .about-label { display: inline-flex; align-items: center; gap: .55rem; margin-bottom: 1rem; color: #ff6b6b; font-size: .8rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
    .about-label::before { content: ""; width: 34px; height: 2px; background: currentColor; }
    .about-hero h1 { margin-bottom: 1.25rem; color: #fff; font-size: clamp(2.6rem,6vw,4.8rem); line-height: 1.04; }
    .about-hero p { max-width: 590px; color: rgba(255,255,255,.84); font-size: 1.1rem; }
    .about-section { padding: clamp(4rem,8vw,6.5rem) 0; }
    .about-copy { color: #6c757d; font-size: 1.04rem; }
    .mission-visual { position: relative; min-height: 460px; }
    .mission-visual img { width: calc(100% - 34px); height: 430px; object-fit: cover; border-radius: 18px; box-shadow: 0 18px 45px rgba(0,0,0,.16); }
    .experience-card { position: absolute; right: 0; bottom: 0; width: 190px; padding: 1.35rem; color: #fff; background: #343a40; border: 6px solid #f8f9fa; border-radius: 16px; box-shadow: 0 14px 35px rgba(0,0,0,.18); }
    .experience-card strong { display: block; color: #ff6b6b; font-size: 2rem; line-height: 1; }
    .experience-card span { display: block; margin-top: .5rem; font-size: .88rem; line-height: 1.35; }
    .about-stat { height: 100%; padding: 1.6rem; text-align: center; background: #fff; border: 1px solid #dee2e6; border-radius: 14px; }
    .about-stat i { margin-bottom: .7rem; color: #dc3545; font-size: 1.45rem; }
    .about-stat strong { display: block; color: #212529; font-size: 1.65rem; }
    .about-stat span { color: #6c757d; font-size: .9rem; }
    .values-section { color: #fff; background: #292929; }
    .values-section h2,.values-section h3 { color: #fff; }
    .value-card { height: 100%; padding: 2rem; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12); border-radius: 16px; transition: .25s ease; }
    .value-card:hover { transform: translateY(-5px); background: rgba(255,255,255,.1); }
    .value-icon { display: grid; width: 48px; height: 48px; margin-bottom: 1.2rem; place-items: center; color: #fff; background: #dc3545; border-radius: 12px; }
    .value-card p { margin: 0; color: rgba(255,255,255,.7); }
    .team-card { height: 100%; padding: 2rem 1.4rem; text-align: center; background: #fff; border: 1px solid #dee2e6; border-radius: 16px; transition: .25s ease; }
    .team-card:hover { transform: translateY(-5px); box-shadow: 0 16px 40px rgba(0,0,0,.12); }
    .team-card img { width: 122px; height: 122px; margin-bottom: 1.2rem; object-fit: cover; border: 5px solid #f1f1f1; }
    .team-card h3 { margin-bottom: .2rem; font-size: 1.1rem; }
    .team-card p { margin: 0; color: #6c757d; }
    .about-cta { padding: 3rem; color: #fff; background: linear-gradient(125deg,#343a40,#1f1f1f); border-radius: 20px; box-shadow: 0 16px 40px rgba(0,0,0,.16); }
    .about-cta h2 { color: #fff; }
    .about-cta p { margin: 0; color: rgba(255,255,255,.72); }
    @@media (max-width: 767.98px) {
        .about-hero { min-height: 460px; background-position: 60% center; }
        .about-hero::before { background: rgba(20,20,20,.72); }
        .mission-visual { min-height: 380px; margin-bottom: 2rem; }
        .mission-visual img { width: calc(100% - 18px); height: 350px; }
        .experience-card { width: 165px; padding: 1rem; }
        .about-cta { padding: 2rem 1.4rem; text-align: center; }
    }
</style>

<section class="about-hero">
    <div class="container-xl">
        <div class="about-hero-content animate__animated animate__fadeInUp">
            <div class="about-label">Our story</div>
            <h1>Hospitality that feels personal.</h1>
            <p>At @Common.CompanyName, every stay is shaped around comfort, genuine care, and the little moments that turn a visit into a lasting memory.</p>
            <a class="btn btn-danger px-4 mt-2" asp-area="" asp-controller="Room" asp-action="Index">Explore our rooms <i class="fas fa-arrow-right ms-2"></i></a>
        </div>
    </div>
</section>

<section class="about-section bg-light">
    <div class="container-xl">
        <div class="row align-items-center g-5">
            <div class="col-lg-6 order-2 order-lg-1">
                <div class="mission-visual">
                    <img src="/images/homepage-optimized.jpg" alt="A peaceful evening view at our hotel" loading="lazy" />
                    <div class="experience-card"><strong>100%</strong><span>Committed to memorable guest experiences</span></div>
                </div>
            </div>
            <div class="col-lg-6 order-1 order-lg-2">
                <div class="about-label">Our mission</div>
                <h2 class="display-6 mb-4">A place to slow down, settle in, and feel at home.</h2>
                <p class="about-copy">We created @Common.CompanyName with a simple purpose: to make every guest feel genuinely welcome. From a smooth booking experience to the comfort of your room, we pay attention to the details so you can focus on enjoying your time away.</p>
                <p class="about-copy mb-4">Our team combines warm Malaysian hospitality with dependable service, thoughtfully designed spaces, and modern conveniences. Whether you visit for a quiet escape, a family holiday, or a business trip, we aim to make your stay effortless.</p>
                <a class="fw-semibold text-danger text-decoration-none" asp-area="" asp-controller="Home" asp-action="ContactUs">Get in touch with our team <i class="fas fa-arrow-right ms-2"></i></a>
            </div>
        </div>
        <div class="row g-3 mt-5">
            <div class="col-6 col-lg-3"><div class="about-stat"><i class="fas fa-concierge-bell"></i><strong>24/7</strong><span>Guest support</span></div></div>
            <div class="col-6 col-lg-3"><div class="about-stat"><i class="fas fa-map-marker-alt"></i><strong>Prime</strong><span>Highlands location</span></div></div>
            <div class="col-6 col-lg-3"><div class="about-stat"><i class="fas fa-bed"></i><strong>6</strong><span>Room experiences</span></div></div>
            <div class="col-6 col-lg-3"><div class="about-stat"><i class="fas fa-heart"></i><strong>One</strong><span>Guest-first promise</span></div></div>
        </div>
    </div>
</section>

<section class="about-section values-section">
    <div class="container-xl">
        <div class="text-center mx-auto mb-5" style="max-width:680px">
            <div class="about-label justify-content-center">What guides us</div>
            <h2 class="display-6 mb-3">Values you can feel in every stay</h2>
            <p class="mb-0 text-white-50">Our values shape how we welcome guests, support one another, and improve every day.</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4"><article class="value-card"><div class="value-icon"><i class="fas fa-handshake"></i></div><h3 class="h5">Genuine care</h3><p>We listen closely, respond thoughtfully, and treat every guest with warmth and respect.</p></article></div>
            <div class="col-md-4"><article class="value-card"><div class="value-icon"><i class="fas fa-gem"></i></div><h3 class="h5">Everyday excellence</h3><p>We hold ourselves to high standards, from a spotless room to a seamless booking journey.</p></article></div>
            <div class="col-md-4"><article class="value-card"><div class="value-icon"><i class="fas fa-lightbulb"></i></div><h3 class="h5">Thoughtful progress</h3><p>We keep learning and improving so every return visit feels even better than the last.</p></article></div>
        </div>
    </div>
</section>

<section class="about-section bg-light">
    <div class="container-xl">
        <div class="text-center mx-auto mb-5" style="max-width:650px">
            <div class="about-label justify-content-center">Meet the team</div>
            <h2 class="display-6 mb-3">The people behind your stay</h2>
            <p class="about-copy mb-0">A dedicated team brought together by a shared love for hospitality and memorable experiences.</p>
        </div>
        <div class="row g-4 justify-content-center">
            <div class="col-md-4"><article class="team-card"><img src="/images/150.png" alt="Erwina, Founder and CEO" class="rounded-circle" loading="lazy" /><h3>Erwina</h3><p>Founder &amp; CEO</p></article></div>
            <div class="col-md-4"><article class="team-card"><img src="/images/150.png" alt="Kai Quan, CTO and Sales Manager" class="rounded-circle" loading="lazy" /><h3>Kai Quan</h3><p>CTO &amp; Sales Manager</p></article></div>
            <div class="col-md-4"><article class="team-card"><img src="/images/150.png" alt="Jun Xiang, Head of Marketing" class="rounded-circle" loading="lazy" /><h3>Jun Xiang</h3><p>Head of Marketing</p></article></div>
        </div>
        <div class="about-cta mt-5 d-flex flex-column flex-lg-row align-items-center justify-content-between gap-4">
            <div><h2 class="h3 mb-2">Ready for your next memorable stay?</h2><p>Find the room that feels just right for your trip.</p></div>
            <a class="btn btn-danger px-4" asp-area="" asp-controller="Room" asp-action="Index">View available rooms <i class="fas fa-arrow-right ms-2"></i></a>
        </div>
    </div>
</section>

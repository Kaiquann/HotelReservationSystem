@{
    ViewBag.Title = "About Us";
}
<style>
    .section3 { background-color: #5b5b5b; }

    .card-body { background: #c0c0c0; }
</style>

<section class="bg-dark text-white py-4">
    <div class="container text-center">
        <p class="lead">Learn more about who we are and what we do</p>
    </div>
</section>

<section class="py-5 bg-light">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h2 class="mb-4">Our Mission</h2>
                <p class="text-muted">
                    At the heart of our company lies a deep commitment to delivering exceptional services that not only meet but exceed the expectations of our valued customers. We believe that providing outstanding service is the key to building lasting relationships, and we are driven by a passion to ensure quality and satisfaction in everything we do.
                    Our mission goes beyond just offering services; it is about creating genuine value for our customers and making a tangible difference in their lives. We strive to understand the unique needs and desires of each individual we serve, tailoring our approach to provide solutions that are both effective and impactful.
                </p>
            </div>
            <div class="col-md-6">
                <img src="/images/AboutUs.jpg" alt="Our Mission" class="img-fluid rounded shadow" loading="lazy">
            </div>
        </div>
    </div>
</section>

<section class="py-5" style="background-color: #dadada;">
    <div class="container">
        <h2 class="text-center mb-5">Our Team</h2>
        <div class="row g-4">
            <div class="col-md-4 text-center">
                <img src="/images/150.png" alt="Team Member" class="rounded-circle mb-3" loading="lazy">
                <h5>ERWINA</h5>
                <p class="text-muted">Founder & CEO</p>
            </div>
            <div class="col-md-4 text-center">
                <img src="/images/150.png" alt="Team Member" class="rounded-circle mb-3" loading="lazy">
                <h5>KAI QUAN</h5>
                <p class="text-muted">CTO & Sales Manager</p>
            </div>
            <div class="col-md-4 text-center">
                <img src="/images/150.png" alt="Team Member" class="rounded-circle mb-3" loading="lazy">
                <h5>JUN XIANG</h5>
                <p class="text-muted">Head of Marketing</p>
            </div>
        </div>
    </div>
</section>

<section class="py-5 section3">
    <div class="container">
        <div class="text-center mb-4">
            <h2 class="text-white">Our Values</h2>
            <p class="text-muted">What drives us to excel</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 shadow border-0">
                    <div class="card-body text-center text-black">
                        <h5 class="card-title">Integrity</h5>
                        <p class="card-text">We uphold the highest standards of honesty and transparency in all we do.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow border-0">
                    <div class="card-body text-center text-black">
                        <h5 class="card-title">Innovation</h5>
                        <p class="card-text">We constantly seek new and better ways to serve our customers and improve our business.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow border-0">
                    <div class="card-body text-center text-black">
                        <h5 class="card-title">Excellence</h5>
                        <p class="card-text">We strive to deliver outstanding results in every aspect of our business.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
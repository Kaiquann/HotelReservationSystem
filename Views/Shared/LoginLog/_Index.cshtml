@model IPagedList<LoginLog>
@{
    string[] fields =
    [
        "Email", "Ip Address", "City", "Region",
        "Country", "Location", "Org",
        "Postal", "Timezone", "LoginTime",
        "Actions"
    ];
}

<partial name="Table/_FilterFormPartial"/>
<partial name="Table/_SearchBarPartial"/>
<partial name="Table/_CountRecordPartial" model="@Model"/>
<table class="table table-bordered table-sm">
    <partial name="Table/_HeaderPartial" model="@fields"/>
    <tbody>
    @foreach (var loginLog in Model)
    {
        <tr>
            <td>@loginLog.Email</td>
            <td>@loginLog.Ip</td>
            <td>@loginLog.City</td>
            <td>@loginLog.Region</td>
            <td>@loginLog.Country</td>
            <td>@loginLog.Loc</td>
            <td>@loginLog.Org</td>
            <td>@loginLog.Postal</td>
            <td>@loginLog.Timezone</td>
            <td>@loginLog.LoginTime</td>
            <td>
                @{
                    string url = string.IsNullOrEmpty(loginLog.Ip) ? "https://whatismyipaddress.com/" : "https://whatismyipaddress.com/ip/" + loginLog.Ip;
                }
                <a href="@url"
                   class="btn btn-secondary btn-sm"
                   target="_blank">
                    <i class="fas fa-eye me-2" aria-hidden="true"></i> View
                </a>
            </td>
        </tr>
    }
    </tbody>
</table>
<partial name="Table/_FooterPartial" model="@Model"/>
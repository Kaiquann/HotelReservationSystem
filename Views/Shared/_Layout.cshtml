﻿@using Microsoft.AspNetCore.Authentication

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewBag.Title | @Common.CompanyName</title>

    <!-- Icon -->
    <link rel="website icon" type="jpg" href="/images/logo.jpg"/>

    <!-- Library Css -->
    <link rel="stylesheet" href="/lib/bootstrap/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="/lib/animatecss/animate.min.css"/>
    <link rel="stylesheet" href="/lib/fontawesome/css/all.min.css"/>
    <link rel="stylesheet" href="/lib/sweetalert2/sweetalert2.min.css"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.10.3/font/bootstrap-icons.min.css">

    <!-- Own Css -->
    <link rel="stylesheet" href="/css/app.css" asp-append-version="true"/>
    <link rel="stylesheet" href="/css/pager.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/HotelReservationSystem.styles.css" asp-append-version="true"/>

    @await RenderSectionAsync("head", false)
</head>
<body>

<header>
    <!-- Loading Spinner -->
    <div id="loader">
        <div class="spinner"></div>
    </div>

    <nav class="navbar navbar-expand-lg navbar-dark site-navbar" aria-label="Main navigation">
        <div class="container-xl">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand-mark" aria-hidden="true"><i class="fas fa-hotel"></i></span>
                <span>@Common.CompanyName</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavigation">
            <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link @Html.IsActive("Home", "Index")" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @Html.IsActive("Room")" asp-area="" asp-controller="Room" asp-action="Index">Rooms</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @Html.IsActive("Home", "AboutUs")" asp-area="" asp-controller="Home" asp-action="AboutUs">About</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @Html.IsActive("Home", "ContactUs")" asp-area="" asp-controller="Home" asp-action="ContactUs">Contact</a>
                </li>
                @if (User.IsLoggedIn() && !User.HasAdminAccess())
                {
                    <li class="nav-item">
                        <a class="nav-link @Html.IsActive("Cart")" asp-area="" asp-controller="Cart" asp-action="Index"><i class="fas fa-shopping-bag me-1" aria-hidden="true"></i> Cart</a>
                    </li>
                }
                @if (User.HasAdminAccess())
                {
                    <li class="nav-item">
                        <a class="nav-link @Html.IsActive("Dashboard")" asp-area="Admin" asp-controller="User" asp-action="Index">Dashboard</a>
                    </li>
                }
            </ul>

            <div class="dropdown account-menu">
                <button id="dropdownToggle" class="dropdownToggle btn" aria-label="Open account menu" aria-haspopup="true" aria-expanded="false">
                    <i class="fas fa-user" aria-hidden="true"></i>
                </button>
                <partial name="_LoginPartial"/>
            </div>
            </div>
        </div>
    </nav>
</header>

<div class="site-content">
    <main role="main">
        @RenderBody()
    </main>
</div>

<footer class="site-footer">
    <div class="container-xl d-flex flex-column flex-md-row align-items-center justify-content-between gap-2">
        <div><span class="footer-brand">@Common.CompanyName</span><span class="ms-2">Comfort in every stay.</span></div>
        <div>&copy; @DateTime.Today.Year @Common.CompanyName. All rights reserved.</div>
    </div>
</footer>

<!-- Library Js -->
<script src="/js/jquery.min.js"></script>
<script src="/js/jquery.validate.min.js"></script>
<script src="/js/jquery.unobtrusive-ajax.min.js"></script>
<script src="/js/jquery.validate.unobtrusive.min.js"></script>
<script src="/lib/bootstrap/js/bootstrap.min.js"></script>
<script src="/lib/fontawesome/js/all.js"></script>
<script src="/lib/sweetalert2/sweetalert2.all.min.js"></script>
<script src="https://cdn.canvasjs.com/canvasjs.min.js"></script>
<script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>

<!-- Own Js -->
<script src="/js/app.js" asp-append-version="true"></script>

<!-- Crisp Chat -->
@if (!User.HasAdminAccess())
{
    <script type="text/javascript">
        window.$crisp = [];
        window.CRISP_WEBSITE_ID = "f2d30349-7f8b-4aa3-8d10-ed46dbd4c067";
        (function() {
            d = document;
            s = d.createElement("script");
            s.src = "https://client.crisp.chat/l.js";
            s.async = 1;
            d.getElementsByTagName("head")[0].appendChild(s);
        })();
    </script>
}

<partial name="_SweetAlert"/>
<div id="ajax-sweetalert">
    <partial name="_SweetAlert"/>
</div>

@await RenderSectionAsync("foot", false)
</body>
</html>

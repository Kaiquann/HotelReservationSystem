﻿@using Microsoft.AspNetCore.Authentication

<ul id="dropdownMenu" class="dropdown-menu dropdown-menu-start my-3">
    @if (User.IsLoggedIn())
    {
        <li class="nav-item">
            <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Profile">Profile</a>
        </li>

        @if (!User.HasAdminAccess())
        {
            <li class="nav-item">
                <a class="dropdown-item" asp-area="" asp-controller="Order" asp-action="Index">Orders</a>
            </li>

            <li class="nav-item">
                <a class="dropdown-item" asp-area="" asp-controller="Booking" asp-action="Index">Bookings</a>
            </li>

            <li class="nav-item">
                <a class="dropdown-item" asp-area="" asp-controller="Transaction" asp-action="Index">Transactions</a>
            </li>
        }

        <li class="nav-item">
            <a class="dropdown-item" asp-area="" asp-controller="LoginLog" asp-action="Index">Login Logs</a>
        </li>

        <li class="nav-item">
            <a class="dropdown-item" data-post="/Account/Logout" data-confirm="Are you sure you want to log out?">Logout</a>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="dropdown-item" asp-area="" asp-controller="Register" asp-action="Index">Register</a>
        </li>
        <li class="nav-item">
            <a class="dropdown-item" asp-area="" asp-controller="Login" asp-action="Index">Login</a>
        </li>
    }
</ul>
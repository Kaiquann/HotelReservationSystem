{
  "version": "1.0",
  "defaultProvider": "cdnjs",
  "defaultDestination": "wwwroot/js/",
  "libraries": [
    {
      "library": "jquery@3.7.1",
      "files": [
        "jquery.min.js"
      ]
    },
    {
      "library": "jquery-ajax-unobtrusive@3.2.6",
      "files": [
        "jquery.unobtrusive-ajax.min.js"
      ]
    },
    {
      "library": "jquery-validate@1.21.0",
      "files": [
        "jquery.validate.min.js"
      ]
    },
    {
      "library": "jquery-validation-unobtrusive@4.0.0",
      "files": [
        "jquery.validate.unobtrusive.min.js"
      ]
    },
    {
      "library": "bootstrap@5.3.3",
      "files": [
        "css/bootstrap.min.css",
        "js/bootstrap.min.js"
      ],
      "destination": "wwwroot/lib/bootstrap/"
    },
    {
      "library": "font-awesome@6.7.0",
      "files": [
        "css/all.min.css",
        "js/all.js"
      ],
      "destination": "wwwroot/lib/fontawesome/"
    },
    {
      "library": "sweetalert2@11.14.5",
      "files": [
        "sweetalert2.all.min.js",
        "sweetalert2.min.css"
      ],
      "destination": "wwwroot/lib/sweetalert2/"
    },
    {
      "library": "animate.css@4.1.1",
      "files": [
        "animate.min.css"
      ],
      "destination": "wwwroot/lib/animatecss/"
    }
  ]
}
